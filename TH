<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Treasure Hunt</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap');
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            background: url('https://i.postimg.cc/gcTVS86D/1738657520755.jpg') no-repeat center center/cover;
            color: white;
            text-align: center;
            background-attachment: fixed;
        }

        h1, h2 {
            color: #ffcc00;
            text-shadow: 0 0 15px #ffcc00, 0 0 30px #ff9900, 0 0 45px #ff9900;
        }

        .container {
            max-width: 700px;
            margin: 100px auto;
            padding: 40px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
            animation: fadeIn 1.5s ease-in-out;
        }

        @keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }

        p { font-size: 20px; }

        .button {
            display: inline-block;
            padding: 15px 30px;
            font-size: 20px;
            background: #ffcc00;
            color: #333;
            border-radius: 10px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.4s;
            cursor: pointer;
            border: none;
            margin-top: 20px;
        }

        .button:hover { background: #ff9900; transform: scale(1.05); }

        .riddle-box, .final-box { display: none; }

        input[type="text"] {
            width: 60%;
            padding: 15px;
            font-size: 18px;
            border-radius: 10px;
            text-align: center;
            margin-top: 20px;
            border: none;
        }

        .message { font-size: 18px; margin-top: 20px; }
        .correct { color: #32cd32; }
        .wrong { color: #ff6347; }

        .popup {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.85);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 4px 30px rgba(0, 0, 0, 0.9);
            text-align: center;
            color: white;
            animation: popUp 0.5s ease-out;
        }

        @keyframes popUp {
            0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
            100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }

        .popup h2 { color: #f2c911; font-size: 30px; margin-bottom: 20px; }

        .popup .button { background: #32cd32; border-radius: 8px; }
        .popup .button:hover { background: #228b22; }
    </style>
</head>
<body>

    <div class="container" id="welcome-box">
        <h1> HEX CORE HUNT</h1>
        <p>Are you ready for the challenge?</p>
        <button class="button" onclick="startHunt()">Start the Treasure Hunt</button>
    </div>

    <div class="container riddle-box" id="riddle1">
        <h2>🔑 Riddle 1</h2>
        <p>What is full of holes but still holds water?</p>
        <input type="text" id="answer1">
        <button class="button" onclick="checkAnswer(1, 'sponge')">Submit</button>
        <p id="message1" class="message"></p>
    </div>

    <div class="container riddle-box" id="riddle2">
        <h2>🔑 Riddle 2</h2>
        <p>What has to be broken before you can use it?</p>
        <input type="text" id="answer2">
        <button class="button" onclick="checkAnswer(2, 'egg')">Submit</button>
        <p id="message2" class="message"></p>
    </div>

    <div class="container riddle-box" id="riddle3">
        <h2>🔑 Riddle 3</h2>
        <p>I stand tall in Paris, a symbol of might... Find the sum of my lat and long.</p>
        <input type="text" id="answer3">
        <button class="button" onclick="checkAnswer(3, '51.1529')">Submit</button>
        <p id="message3" class="message"></p>
    </div>

    <div class="container riddle-box" id="riddle4">
        <h2>🔑 Riddle 4</h2>
        <p>I have weights but I'm not a scale... What am I?</p>
        <input type="text" id="answer4">
        <button class="button" onclick="checkAnswer(4, 'gym', true)">Submit</button>
        <p id="message4" class="message"></p>
    </div>

    <div class="popup" id="popup">
        <h2>🎉 Congrats! You Got It!</h2>
        <p>You have completed the treasure hunt successfully!</p>
        <button class="button" onclick="showFinalLocation()">See the Location</button>
    </div>

    <div class="container final-box" id="final-box">
        <h1>🎉 You Found the Location!</h1>
        <p><strong>📍 Location:</strong> Swasthi</p>
        <p><strong>🎬 Movie Dialogue:</strong> "കേരളത്തിലെ പിള്ളേർക്ക് എന്തിനാടാ SIX PACK!"</p>
    </div>

    <script>
        function startHunt() {
            document.getElementById("welcome-box").style.display = "none";
            document.getElementById("riddle1").style.display = "block";
        }

        function checkAnswer(riddleNum, correctAnswer, isLast = false) {
            var answer = document.getElementById("answer" + riddleNum).value.trim().toLowerCase();
            var message = document.getElementById("message" + riddleNum);

            if (answer === correctAnswer) {
                message.innerHTML = "✅ Correct!";
                message.className = "message correct";

                setTimeout(() => {
                    document.getElementById("riddle" + riddleNum).style.display = "none";
                    if (isLast) {
                        document.getElementById("popup").style.display = "block";
                    } else {
                        document.getElementById("riddle" + (riddleNum + 1)).style.display = "block";
                    }
                }, 1000);
            } else {
                message.innerHTML = "❌ Wrong answer! Try again.";
                message.className = "message wrong";
            }
        }

        function showFinalLocation() {
            document.getElementById("popup").style.display = "none";
            document.getElementById("final-box").style.display = "block";
        }
    </script>

</body>
</html>